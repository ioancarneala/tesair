# Adopt shrinking separately from code rewriting and renaming. This keeps release
# diagnostics readable and limits the first optimized build to removing dead code.
-dontoptimize
-dontobfuscate

# Crypto providers resolve implementations by class name as well as direct calls.
-keep class org.bouncycastle.** { *; }
# Bouncy Castle also ships a desktop LDAP certificate-store provider. Android has
# no JNDI and TesAir never selects this provider; other missing classes stay errors.
-dontwarn javax.naming.**

# JNI entry points must retain the names exported by the bundled native libraries.
-keepclasseswithmembernames,includedescriptorclasses class * {
    native <methods>;
}

# linux_i2c_jni.c constructs this exception directly through JNI.
-keep class com.shilapi.xcertplay.transport.LinuxI2cNativeException {
    <init>(int, java.lang.String);
}

# Shell helpers are launched by app_process, outside the Android manifest graph.
-keepclasseswithmembers class com.shilapi.xcertplay.** {
    public static void main(java.lang.String[]);
}
