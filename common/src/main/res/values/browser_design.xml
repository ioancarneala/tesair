<resources>
    <color name="browser_paper">#FFFEFD</color>
    <color name="browser_ink">#142935</color>
    <color name="browser_muted">#586B73</color>
    <color name="browser_line">#DCE6E8</color>
    <color name="browser_field">#F3F6F6</color>
    <color name="browser_accent">#235C69</color>
    <color name="browser_on_accent">#FFFFFF</color>
    <color name="browser_wash">#EAF3F3</color>
    <color name="browser_error">#A32525</color>
    <color name="browser_success">#28674A</color>
    <style name="Theme.Browser.Onboarding" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/browser_accent</item>
        <item name="android:windowBackground">@color/browser_paper</item>
        <item name="android:colorBackground">@color/browser_paper</item>
        <item name="android:textColorPrimary">@color/browser_ink</item>
        <item name="android:textColorSecondary">@color/browser_muted</item>
        <item name="android:statusBarColor">@color/browser_paper</item>
        <item name="android:navigationBarColor">@color/browser_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:alertDialogTheme">@style/Theme.Browser.Onboarding.Dialog</item>
    </style>
    <style name="Theme.Browser.Onboarding.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/browser_setup_dialog_background</item>
        <item name="android:colorBackground">@color/browser_paper</item>
        <item name="android:textColorPrimary">@color/browser_ink</item>
        <item name="android:textColorSecondary">@color/browser_muted</item>
        <item name="android:colorAccent">@color/browser_accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonBarButtonStyle">@style/Browser.DialogButton</item>
    </style>
</resources>
