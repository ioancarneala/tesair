    <string name="browser_telemetry_title">帮助改进 TesAir</string>
    <string name="browser_telemetry_description">分享设置、连接和性能方面的技术数据。参与完全自愿，可随时在设置中关闭。</string>
    <string name="browser_telemetry_content_private">不收集 CarPlay 图像、音频、消息、位置或 Wi-Fi 详情。报告使用随机安装 ID，并保留 30 天。</string>
